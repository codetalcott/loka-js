{
  "name": "loka-js",
  "version": "1.1.0",
  "description": "Write fixi-family HTML in your own language. fixi in 23 languages, the whole family in Spanish so far. No DOM mutation, per-element selection.",
  "license": "0BSD",
  "author": "Wm Talcott",
  "main": "fixi.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/loka-js.git"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/loka-js/issues"
  },
  "homepage": "https://github.com/codetalcott/loka-js#readme",
  "files": [
    "fixi.js",
    "moxi.js",
    "paxi.js",
    "ssexi.js",
    "rexi.js",
    "loka.js",
    "lang-resolver.js",
    "locales/",
    "dom-vocab/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node scripts/gen-locales.mjs",
    "brief": "node scripts/research-brief.mjs",
    "queue-research": "node scripts/queue-research.mjs",
    "verify-prompt": "node scripts/verify-prompt.mjs",
    "test": "node test/gen-drift.mjs && node test/vocab-ordering.mjs && npm run test:browser",
    "test:browser": "node test/loka-js.spec.mjs && node test/preservation.mjs && node test/joint-demo-check.mjs && node test/psatina-study-es-check.mjs",
    "test:drift": "node test/gen-drift.mjs",
    "test:vocab": "node test/vocab-ordering.mjs"
  },
  "keywords": [
    "fixi",
    "fixiproject",
    "i18n",
    "internationalization",
    "localization",
    "hypermedia",
    "html",
    "attributes",
    "polyglot",
    "multilingual"
  ],
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
